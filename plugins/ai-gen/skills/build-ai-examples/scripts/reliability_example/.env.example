# Copy to .env and fill in. Never commit the filled-in file.
# Every name here is read by agent.py; tests/smoke_test.py fails the build
# when the code and this file drift apart.
#
# Only agent.py needs this -- reliability_core.py needs no key at all: the
# circuit breaker, the ladder and both idempotency caches are plain Python,
# not model calls.

OPENROUTER_API_KEY=
CHAT_MODEL=openai/gpt-4o-mini
FALLBACK_MODEL=openai/gpt-4o-mini
